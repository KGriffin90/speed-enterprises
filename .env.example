# Top-level env example. Copy to .env and fill in.
# apps/api/.env.example is the source of truth for API-specific env.

NODE_ENV=development

# Platform identity (used in default sender, super-admin invites)
PLATFORM_NAME="Speed Enterprises"
PLATFORM_DOMAIN="speedenterprises.app"
PLATFORM_SUPPORT_EMAIL="support@speedenterprises.app"

# Postgres — matches docker-compose.yml (host port 5433 to avoid colliding with
# other local Postgres instances, e.g. the speed-enterprise project on 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/speed_enterprises?schema=public"
