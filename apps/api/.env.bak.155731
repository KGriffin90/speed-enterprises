# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Comma-separated CORS allowlist (tenants' custom domains go here in prod)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Number of reverse-proxy hops in front of the API (LB/CDN). Lets rate limiting
# key on the real client IP via X-Forwarded-For. 1 = single LB; 2 = CDN -> LB.
# Setting this HIGHER than reality lets clients spoof their IP to bypass limits.
# Defaults to 1 in production, 0 in dev.
TRUST_PROXY_HOPS=0

# Redis connection for shared, cross-instance rate limiting (rediss:// = TLS).
# Unset → in-memory per-instance limits (fine for a single instance / dev).
# e.g. redis://default:password@host:6379  or  rediss://host:6380
REDIS_URL=

# Platform identity
PLATFORM_NAME="Speed Enterprises"
PLATFORM_DOMAIN=speedenterprises.app
PLATFORM_SUPPORT_EMAIL=support@speedenterprises.app
PLATFORM_DEFAULT_FROM="Speed Enterprises <noreply@mail.speedenterprises.app>"

# ── Database ────────────────────────────────────────────────────────────────
# Host port 5433 → docker container 5432. Picked to avoid colliding with
# speed-enterprise (or any other local Postgres) on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/speed_enterprises?schema=public

# ── Tenancy topology ────────────────────────────────────────────────────────
# pool          → one shared database, row-level tenantId isolation (default).
# db-per-tenant → every tenant gets its own physical database (max isolation).
TENANCY_MODE=pool

# Control-plane (catalog) DB: identity + tenant registry. In pool mode this can
# equal DATABASE_URL. In db-per-tenant mode point it at a DEDICATED database.
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/speed_enterprises?schema=public

# ── db-per-tenant only (ignored in pool mode) ───────────────────────────────
# Superuser/owner connection used ONLY to CREATE/DROP tenant databases.
TENANT_DB_ADMIN_URL=postgresql://postgres:postgres@db.internal:5432/postgres
# Template for a tenant connection string. {db} is replaced with the generated
# database name. Use a LEAST-PRIVILEGE role and a small connection_limit.
TENANT_DB_URL_TEMPLATE=postgresql://tenant_rw:CHANGE_ME@db.internal:5432/{db}?sslmode=require&connection_limit=3
# Encryption key ring for tenant connection strings (AES-256-GCM). First entry
# is primary. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_SECRET_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# Connection-pool registry tuning.
TENANT_MAX_CLIENTS=50
TENANT_CLIENT_IDLE_MS=300000

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-speed-enterprises-jwt-secret-change-me-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: enable Google sign-in
GOOGLE_CLIENT_ID=

# ── Email ──────────────────────────────────────────────────────────────────
# Set RESEND_API_KEY for production. In dev, leave empty to use Mailhog (SMTP on localhost:1025).
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=

# ── Postmark (transactional email) ──────────────────────────────────────────
# Server API token (Postmark → Servers → API Tokens). Empty in dev = console
# fallback (no real delivery). NEVER commit a real token.
POSTMARK_SERVER_TOKEN=
# Verified sender on an authenticated domain; falls back to PLATFORM_DEFAULT_FROM.
POSTMARK_FROM=
POSTMARK_MESSAGE_STREAM=outbound
# HTTP Basic Auth the Postmark webhook must present (set the same on the webhook URL).
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=

# ── S3 / uploads ───────────────────────────────────────────────────────────
S3_BUCKET=speed-enterprises-uploads-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_HOST=  # CloudFront/public domain in prod

# ── Stripe (optional) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Twilio SMS (optional) ──────────────────────────────────────────────────
# Set these to send real SMS. Per-tenant From-number comes from BusinessConfig.contact.smsNumber.
# If TWILIO_MESSAGING_SERVICE_SID is set it's used instead of the tenant's From-number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ── AI (Anthropic) ─────────────────────────────────────────────────────────
# Powers the AI features in src/ai. Empty → AI endpoints return "not configured".
ANTHROPIC_API_KEY=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

# ── Automation ─────────────────────────────────────────────────────────────
# Set to 'false' to disable all scheduled jobs (follow-ups, review requests, auto-expiry).
AUTOMATION_ENABLED=true
