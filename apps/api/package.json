{
  "name": "@speed-enterprises/api",
  "version": "0.1.0",
  "private": true,
  "description": "Speed Enterprises API — multi-tenant NestJS backend",
  "scripts": {
    "dev": "tsc --build tsconfig.json --force && nest start --watch",
    "dev:fast": "nest start --watch",
    "clean": "rm -rf dist .tsbuildinfo",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json",
    "test": "jest",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup-users": "tsx prisma/cleanup-users.ts",
    "db:reset-to-owner": "tsx prisma/reset-to-owner.ts",
    "setup:weekly-routes": "tsx scripts/setup-weekly-routes.ts",
    "backfill:stop-coords": "tsx scripts/backfill-stop-coords.ts",
    "db:seed-customers": "tsx prisma/seed-customers.ts",
    "db:seed-quotes": "tsx prisma/seed-quotes.ts",
    "db:sync-tenant-data": "tsx prisma/sync-tenant-data.ts",
    "db:migrate-tenants": "tsx prisma/migrate-all-tenants.ts",
    "db:rls": "dotenv -e .env sh -c 'psql $DATABASE_URL -f prisma/sql/01-row-level-security.sql'",
    "db:rls:verify": "dotenv -e .env sh -c 'psql $DATABASE_URL -f prisma/sql/02-verify-rls.sql'",
    "prisma": "prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.22.0",
    "@speed-enterprises/shared": "workspace:*",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^9.14.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "nestjs-zod": "^3.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "postmark": "^4.0.7",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.1",
    "stripe": "^22.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.7.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^7.4.4",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
