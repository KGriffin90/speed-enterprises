# API origin the app talks to. EXPO_PUBLIC_* vars are inlined at BUILD time.
#
# Local dev (simulator):        http://localhost:4000
# Local dev (physical device):  http://<your-mac-LAN-IP>:4000
# Production builds:            must be https:// (release builds refuse http)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Single-tenant standalone: the one business this app serves.
EXPO_PUBLIC_DEFAULT_TENANT=speedenterprises
