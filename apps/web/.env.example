# API origin — used by SSR config fetch + client POSTs
API_ORIGIN=http://localhost:4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Platform identity (matches apps/api/.env)
PLATFORM_NAME="Speed Enterprises"
# Apex domain the middleware uses for subdomain→tenant resolution.
#   prod: speedenterprises.app   (tenants live at acme.speedenterprises.app)
#   dev:  localhost:3000  (tenants via /t/<slug>/… path or ?tenant=<slug>)
PLATFORM_DOMAIN=localhost:3000
# Exposed to the Edge middleware bundle (middleware can't read server-only env
# reliably across all hosts). Keep in sync with PLATFORM_DOMAIN.
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000

# Single-tenant standalone: tenant rendered when no host/path/query resolves one.
NEXT_PUBLIC_DEFAULT_TENANT=speedenterprises

# ── Mobile deep-link domain verification (optional) ───────────────────────────
# Served at /.well-known/apple-app-site-association and /.well-known/assetlinks.json.
# Leave unset and both endpoints return 404 — i.e. this host claims no app, and
# appointment-email links keep opening the website (the current behaviour).
# See apps/mobile/deep-linking/README.md for the full setup + verification steps.
#
# "<APPLE_TEAM_ID>.<bundleIdentifier>" — Team ID from developer.apple.com →
# Membership, or `eas credentials`.
# IOS_APP_ID=ABCDE12345.com.speedenterprises.app
#
# SHA-256 of the cert that signs the SHIPPED app. With Play App Signing that is
# the *app signing key* (Play Console → Setup → App signing), NOT the upload key.
# Comma-separate to publish several (e.g. during a signing-key migration).
# ANDROID_CERT_SHA256=AA:BB:CC:...:FF
